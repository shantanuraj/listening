[Unit]
Description=listening app server
After=network.target

[Service]
User=svc-listening
Group=svc-listening
WorkingDirectory=/opt/listening
Environment=HOME=/var/lib/listening
EnvironmentFile=/opt/listening/listening.env
ExecStart=/opt/listening/listening
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/listening
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
